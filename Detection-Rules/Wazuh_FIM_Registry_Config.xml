<!-- Wazuh Agent Configuration for File Integrity and Registry Monitoring (Syscheck) -->
<syscheck>
  <disabled>no</disabled>
  <frequency>300</frequency> <!-- Scan every 5 minutes -->

  <!-- File Integrity Monitoring (FIM) -->
  <directories check_all="yes" report_changes="yes" realtime="yes">C:\Users\RA\Downloads</directories>
  <directories check_all="yes" report_changes="yes" whodata="yes">C:\RA</directories>
  
  <!-- Registry Monitoring for Persistence and Defense Evasion -->
  <windows_registry arch="both">HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Run</windows_registry>
  <windows_registry arch="both">HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\RunOnce</windows_registry>
  <windows_registry arch="both">HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Winlogon</windows_registry>
  
  <windows_registry recursion_level="3" report_changes="yes">HKEY_LOCAL_MACHINE\SYSTEM\Setup</windows_registry>
</syscheck>